<Window x:Class="ShutdownTimer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="Shutdown Timer"
        Height="620" Width="420"
        MinHeight="620" MinWidth="420"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="Segoe UI">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets"
                           FontSize="28" Foreground="{StaticResource AccentBrush}"
                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Text="SHUTDOWN TIMER" FontSize="22" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="Schedule your laptop shutdown"
                       FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"
                       Margin="38,4,0,0"/>
        </StackPanel>

        <!-- CARD TIMER -->
        <Border Grid.Row="1"
                Background="{StaticResource CardBrush}"
                CornerRadius="16"
                Padding="24">
            <StackPanel>

                <TextBlock Text="SET TIMER" FontSize="13" FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,0,0,16"/>

                <!-- Input Jam Menit Detik -->
                <Grid Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBox x:Name="TxtHours" Text="02" MaxLength="2"
                                 Style="{StaticResource TimeInputBox}"/>
                        <TextBlock Text="HOURS" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center" Margin="0,6,0,0"/>
                    </StackPanel>

                    <TextBlock Grid.Column="1" Text=":" FontSize="26" FontWeight="Bold"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Top" Margin="8,10,8,0"/>

                    <StackPanel Grid.Column="2">
                        <TextBox x:Name="TxtMinutes" Text="30" MaxLength="2"
                                 Style="{StaticResource TimeInputBox}"/>
                        <TextBlock Text="MINUTES" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center" Margin="0,6,0,0"/>
                    </StackPanel>

                    <TextBlock Grid.Column="3" Text=":" FontSize="26" FontWeight="Bold"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Top" Margin="8,10,8,0"/>

                    <StackPanel Grid.Column="4">
                        <TextBox x:Name="TxtSeconds" Text="00" MaxLength="2"
                                 Style="{StaticResource TimeInputBox}"/>
                        <TextBlock Text="SEC" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center" Margin="0,6,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- Countdown Display -->
                <TextBlock x:Name="TxtCountdown" Text="02 : 30 : 00"
                           FontSize="40" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,16"/>

                <!-- Progress Bar -->
                <Border Height="8" CornerRadius="4"
                        Background="{StaticResource BackgroundBrush}"
                        Margin="0,0,0,24">
                    <Border x:Name="ProgressFill"
                            Height="8" CornerRadius="4"
                            Background="{StaticResource AccentBrush}"
                            HorizontalAlignment="Left"
                            Width="0"/>
                </Border>

                <!-- Tombol Start Cancel -->
                <Button x:Name="BtnStart" Content="START TIMER"
                        Style="{StaticResource PrimaryButton}"
                        Height="48" Margin="0,0,0,12"
                        Click="BtnStart_Click"/>

                <Button x:Name="BtnCancel" Content="CANCEL SHUTDOWN"
                        Style="{StaticResource DangerButton}"
                        Height="48" IsEnabled="False"
                        Click="BtnCancel_Click"/>

                <!-- Status -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,24,0,0">
                    <Ellipse x:Name="StatusDot" Width="10" Height="10"
                             Fill="{StaticResource TextSecondaryBrush}"
                             VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock x:Name="TxtStatus" Text="Timer belum aktif"
                               FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Credit -->
                <TextBlock Text="by RanZx"
                           FontSize="11"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Opacity="0.5"
                           HorizontalAlignment="Center"
                           Margin="0,16,0,0"/>

            </StackPanel>
        </Border>
    </Grid>
</Window>